{
  "name": "distributed-job-scheduler",
  "version": "1.0.0",
  "description": "Production-Inspired Distributed Job Scheduler with PostgreSQL, atomic claiming, multi-worker pool, DLQ, heartbeats, and React dashboard",
  "main": "server/src/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run worker\" \"npm run client\"",
    "server": "node --watch server/src/server.js",
    "worker": "node --watch worker/src/worker.js",
    "client": "npm --prefix client run dev",
    "db:migrate": "node database/migrations/run_migrations.js",
    "db:seed": "node database/seed/seed.js",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
